-- Run this in Supabase SQL Editor
-- Creates the installation jobs table for the Freeflow calendar

CREATE TABLE IF NOT EXISTS install_jobs (
  id uuid DEFAULT gen_random_uuid() PRIMARY KEY,
  job_date date NOT NULL,
  job_number text,
  location_name text NOT NULL,
  address text,
  techs jsonb DEFAULT '[]',
  notes text DEFAULT '',
  created_at timestamptz DEFAULT now()
);

-- Enable Row Level Security
ALTER TABLE install_jobs ENABLE ROW LEVEL SECURITY;

-- Allow anyone to read jobs (calendar is view-only for non-admins)
CREATE POLICY "Public read" ON install_jobs
  FOR SELECT USING (true);

-- Allow anyone with the anon key to insert/update/delete
-- (password protection is handled in the app itself)
CREATE POLICY "Anon write" ON install_jobs
  FOR ALL USING (true) WITH CHECK (true);

-- Confirm
SELECT 'Table install_jobs created successfully' AS result;
